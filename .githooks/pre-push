#!/bin/sh
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: running tests before updating main"
      npm test --silent || exit 1
      if git log --format=%s "$remote_sha..$local_sha" 2>/dev/null | grep -q '^wip:'; then
        echo "pre-push: wip commits cannot go to main"
        exit 1
      fi
      ;;
  esac
done
exit 0
